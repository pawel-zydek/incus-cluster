<!--
  Sieć libvirta dla klastra: NAT do internetu przez laptopa.
  DHCP służy tylko instalatorowi (rezerwacje = te same adresy co w nodes.nix);
  zainstalowany węzeł ma adres ustawiony statycznie.
-->
<network>
  <name>incuslab</name>
  <forward mode="nat"/>
  <bridge name="virbr150" stp="on" delay="0"/>
  <domain name="lab" localOnly="yes"/>
  <ip address="192.168.150.1" netmask="255.255.255.0">
    <dhcp>
      <range start="192.168.150.100" end="192.168.150.199"/>
      <host mac="52:54:00:50:00:11" name="incus1" ip="192.168.150.11"/>
      <host mac="52:54:00:50:00:12" name="incus2" ip="192.168.150.12"/>
      <host mac="52:54:00:50:00:13" name="incus3" ip="192.168.150.13"/>
    </dhcp>
  </ip>
</network>
